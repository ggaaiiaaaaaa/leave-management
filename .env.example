# J.T. Yeo CPA Leave Management System - Production Environment Configuration
# Copy this file to .env on Hostinger or your production server.

# Base URL (Optional: auto-detected, but recommended if using a custom domain or proxy)
LEAVE_BASE_URL=https://jtyeoaccounting.com

# SMTP Email Configuration (Hostinger Titan Mail / Google Workspace / Office 365)
# Fill in your mail server credentials below:
LEAVE_SMTP_HOST=smtp.hostinger.com
LEAVE_SMTP_PORT=587
LEAVE_SMTP_SECURE=tls
LEAVE_SMTP_USERNAME=notifications@jtyeoaccounting.com
LEAVE_SMTP_PASSWORD=your_secure_email_password
LEAVE_SMTP_FROM_EMAIL=notifications@jtyeoaccounting.com
LEAVE_SMTP_FROM_NAME=J.T. Yeo CPA Accounting Office

# ZKTeco Biometric Device Security
# Comma-separated list of trusted office public IP addresses that push biometric punches.
# Leave blank during testing, or specify your office static public IP for production security.
LEAVE_DEVICE_IPS=

# SQLite Data Directory (Optional: by default auto-discovers or falls back to protected database folder)
# LEAVE_DATA_DIR=/home/u123456789/leave-jtyeo-data
